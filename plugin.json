{
  "$schema": "https://github.com/duxlabs-dev/dux-shell/raw/refs/heads/master/quickshell/PLUGINS/plugin-schema.json",
  "id": "aiQuotas",
  "name": "AI Quotas",
  "description": "Monitor Claude, Codex, GitHub Copilot, OpenCode Go, Z.ai, Kimi Code, DeepSeek, OpenRouter, Grok, and Antigravity usage limits and balances in your bar.",
  "version": "2.0.0",
  "author": "agneswd",
  "license": "MIT",
  "type": "composite",
  "capabilities": ["dankbar-widget", "daemon"],
  "components": {
    "daemon": "./AiQuotasDaemon.qml",
    "widget": "./AiQuotasWidget.qml"
  },
  "settings": "./AiQuotasSettings.qml",
  "startupCheck": "./StartupCheck.qml",
  "icon": "speed",
  "requires_dms": ">=2.0.0",
  "dependencies": ["curl", "jq"],
  "permissions": ["settings_read", "settings_write", "process", "network"]
}
