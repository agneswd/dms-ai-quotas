{
  "$schema": "https://github.com/AvengeMedia/DankMaterialShell/raw/refs/heads/master/PLUGINS/plugin-schema.json",
  "id": "aiQuotas",
  "name": "AI Quotas",
  "description": "Claude, Codex, OpenCode, and Antigravity usage limits plus DeepSeek balance and Grok billing quotas in your bar.",
  "version": "1.7.0",
  "author": "agneswd",
  "license": "MIT",
  "type": "composite",
  "capabilities": ["dankbar-widget", "daemon"],
  "components": {
    "daemon": "./AiQuotasDaemon.qml",
    "widget": "./AiQuotasWidget.qml"
  },
  "settings": "./AiQuotasSettings.qml",
  "startupCheck": "./StartupCheck.qml",
  "icon": "speed",
  "requires_dms": ">=1.5.0",
  "dependencies": ["curl", "jq"],
  "permissions": ["settings_read", "settings_write", "process", "network"]
}
